# Copy this file to .env and edit - .env is gitignored and never committed.

# Folder containing your lesson notes. Defaults to the local notes/ folder if unset.
# VAULT_DIR=C:\path\to\your\notes

# Which curriculum module supplies TERM_OVERRIDE/SKIP/EXTRA/EXAMPLE_EN_OVERRIDE.
# Defaults to curriculum.blank (all empty) if unset.
# CURRICULUM_MODULE=curriculum.minna_no_nihongo
